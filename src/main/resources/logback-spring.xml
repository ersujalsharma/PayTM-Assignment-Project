<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Structured JSON logs to stdout so the platform (Render) captures them.
         Every line carries the correlation/request id via MDC key "requestId". -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdcKeyName>requestId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
            <includeMdcKeyName>showId</includeMdcKeyName>
            <customFields>{"service":"seat-reservation"}</customFields>
        </encoder>
    </appender>

    <!-- Human-readable logs for local dev, toggled by the "dev" profile. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{requestId}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <springProfile name="dev">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!dev">
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
